<Window x:Class="UsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Usage" Icon="Assets/usage-widget.ico" Width="304" Height="590" WindowStyle="None" ResizeMode="NoResize"
        Background="#111316" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Border x:Name="Surface" CornerRadius="22" Background="#111316" BorderBrush="#33363C" BorderThickness="1">
        <Grid>
            <wv:WebView2 x:Name="Browser" Visibility="Hidden" />
            <Border x:Name="Startup" Background="#111316" CornerRadius="21">
                <StackPanel VerticalAlignment="Center" Margin="26">
                    <Image Source="Assets/usage-widget.png" Width="46" Height="46" HorizontalAlignment="Center" />
                    <TextBlock Text="사용량 카드 준비 중" Foreground="#ECEEE9" FontSize="15" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock x:Name="ErrorText" Foreground="#A7ABA8" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
                    <Button x:Name="ExitButton" Content="닫기" Visibility="Collapsed" Click="Exit_Click" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
